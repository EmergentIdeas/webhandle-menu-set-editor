<div class="menu-set-editor-frame">
	<div class="tree-side">
		<div class="menu-controls">
			<select name="availableMenus">

			</select>
			<button type="button" class="btn create-menu" title="create new menu">
				<span class="material-icons thumbnail-icon">
					format_list_bulleted_add
				</span>
			</button>
			<button type="button" class="btn delete-menu" title="delete selected menu">
				<span class="material-icons thumbnail-icon">
					delete
				</span>
			</button>
			<button type="button" class="btn save-menus" title="save menus">
				<span class="material-icons thumbnail-icon">
					save
				</span>
			</button>
		</div>
		<div class="treebox">

		</div>
		<div class="tree-controls">
			<button type="button" class="btn create-item" title="create new menu item">
				<span class="material-icons thumbnail-icon">
					add
				</span>
			</button>
			<button type="button" class="btn delete-item" title="delete selected menu item">
				<span class="material-icons thumbnail-icon">
					remove
				</span>
			</button>
		</div>
	</div>
	<div class="node-view">

	</div>
	<template id="menu-item-details-template" >
		<div class="ei-form-styles">
			<input type="hidden" name="id" />
			<label>
				Label
				<input name="label" type="text" />
			</label>
			<label>
				URL
				<input name="url" type="text" />
			</label>
			<label>
				Custom classes
				<input name="customClasses" type="text" />
			</label>
			<label>
				Image
				<input name="image" type="hidden" data-view-component="@webhandle/image-input" />
			</label>
			<h2>
				Attributes
			</h2>
			<table border="1">
				<tbody>
					<tr>
						<th>Attribute name</th>
						<th>Value</th>
					</tr>
					<tr>
						<td>
							<input name="attrName" type="text">	
						</td>
						<td>
							<input name="attrValue" type="text">	
						</td>
					</tr>
					<tr>
						<td>
							<input name="attrName" type="text">	
						</td>
						<td>
							<input name="attrValue" type="text">	
						</td>
					</tr>
					<tr>
						<td>
							<input name="attrName" type="text">	
						</td>
						<td>
							<input name="attrValue" type="text">	
						</td>
					</tr>
					<tr>
						<td>
							<input name="attrName" type="text">	
						</td>
						<td>
							<input name="attrValue" type="text">	
						</td>
					</tr>
					<tr>
						<td>
							<input name="attrName" type="text">	
						</td>
						<td>
							<input name="attrValue" type="text">	
						</td>
					</tr>
					
				</tbody>
				
			</table>
		</div>
	</template>
</div>